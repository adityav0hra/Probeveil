generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AUDITOR
}

enum ScanMode {
  QUICK
  FULL
  MAXIMUM
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum StageStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum Confidence {
  CONFIRMED
  HIGH
  PROBABLE
  POTENTIAL
  INFORMATIONAL
  MANUAL_REVIEW
}

enum FindingStatus {
  OPEN
  CONFIRMED
  FALSE_POSITIVE
  ACCEPTED_RISK
  FIXED
  RETEST_PASSED
  RETEST_FAILED
}

enum ReportType {
  EXECUTIVE_HTML
  TECHNICAL_HTML
  JSON
  CSV
  SARIF
  CYCLONEDX
  SPDX
  RAW_ARCHIVE
  EVIDENCE_ARCHIVE
}

enum RetestStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

enum ContactEnquiryType {
  PRODUCT_ENQUIRY
  SECURITY_REVIEW
  DEMO_REQUEST
  PARTNERSHIP
  TECHNICAL_SUPPORT
  OTHER
}

enum ContactScanDepth {
  NOT_SURE
  QUICK_SCAN
  DEEP_SCAN
  EXHAUSTIVE_SCAN
}

enum ContactEnquiryStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
  SPAM
}

enum ContactEmailStatus {
  NOT_CONFIGURED
  SENT
  FAILED
}

model User {
  id                       String           @id @default(cuid())
  name                     String?
  email                    String           @unique
  emailVerified            DateTime?
  image                    String?
  passwordHash             String?
  role                     Role             @default(ADMIN)
  mfaEnabled               Boolean          @default(false)
  accounts                 Account[]
  sessions                 Session[]
  scans                    Scan[]
  reviews                  FindingReview[]
  auditLogs                AuditLog[]
  assignedContactEnquiries ContactEnquiry[] @relation("AssignedContactEnquiries")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Scan {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  originalUrl    String             @db.Text
  normalizedUrl  String             @db.Text
  finalUrl       String?            @db.Text
  normalizedHash String
  mode           ScanMode
  status         ScanStatus         @default(QUEUED)
  securityScore  Int?
  coverageScore  Int?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  error          String?            @db.Text
  stages         ScanStage[]
  targets        ScanTarget[]
  endpoints      Endpoint[]
  services       Service[]
  technologies   Technology[]
  findings       Finding[]
  attackPaths    AttackPath[]
  retests        Retest[]
  reports        Report[]
  artifacts      EvidenceArtifact[]
  jobs           WorkerJob[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([normalizedHash, status])
  @@index([userId])
}

model ScanTarget {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  url       String   @db.Text
  hostname  String
  kind      String
  inScope   Boolean  @default(false)
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([scanId, url])
  @@index([scanId, inScope])
}

model ScanProfile {
  id          String   @id @default(cuid())
  name        String   @unique
  mode        ScanMode
  stageConfig Json
  limits      Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScanStage {
  id          String      @id @default(cuid())
  scanId      String
  scan        Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  key         String
  label       String
  order       Int
  status      StageStatus @default(PENDING)
  progress    Int         @default(0)
  message     String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([scanId, key])
  @@index([scanId, order])
}

model Endpoint {
  id           String      @id @default(cuid())
  scanId       String
  scan         Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  url          String      @db.Text
  method       String      @default("GET")
  statusCode   Int?
  contentType  String?
  title        String?
  depth        Int         @default(0)
  tested       Boolean     @default(false)
  external     Boolean     @default(false)
  discoveredBy String
  parameters   Parameter[]
  createdAt    DateTime    @default(now())

  @@unique([scanId, url, method])
  @@index([scanId, tested])
}

model Parameter {
  id         String   @id @default(cuid())
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  name       String
  location   String
  dataType   String?
  tested     Boolean  @default(false)

  @@unique([endpointId, name, location])
}

model Service {
  id       String  @id @default(cuid())
  scanId   String
  scan     Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  host     String
  ip       String?
  port     Int?
  protocol String
  tls      Json?
  external Boolean @default(false)

  @@index([scanId])
}

model Technology {
  id       String  @id @default(cuid())
  scanId   String
  scan     Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name     String
  version  String?
  category String?
  evidence String? @db.Text

  @@unique([scanId, name, version])
}

model Finding {
  id                 String            @id @default(cuid())
  scanId             String
  scan               Scan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title              String
  description        String            @db.Text
  category           String
  cwe                String?
  owaspCategory      String?
  severity           Severity
  confidence         Confidence
  status             FindingStatus     @default(OPEN)
  cvssScore          Float?
  affectedUrl        String?           @db.Text
  sourceFile         String?
  lineNumber         Int?
  httpMethod         String?
  parameter          String?
  component          String?
  userRole           String?
  payload            String?           @db.Text
  scannerName        String
  scannerRuleId      String
  scannerVersion     String
  fingerprint        String
  detectedAt         DateTime          @default(now())
  reproductionSteps  Json
  impact             String            @db.Text
  remediation        String            @db.Text
  references         Json
  retestInstructions String?           @db.Text
  adminNotes         String?           @db.Text
  evidence           FindingEvidence[]
  reviews            FindingReview[]
  retests            Retest[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([scanId, fingerprint])
  @@index([scanId, severity, status])
  @@index([cwe])
}

model FindingEvidence {
  id         String            @id @default(cuid())
  findingId  String
  finding    Finding           @relation(fields: [findingId], references: [id], onDelete: Cascade)
  type       String
  title      String
  content    String?           @db.Text
  artifactId String?
  artifact   EvidenceArtifact? @relation(fields: [artifactId], references: [id])
  sha256     String
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([findingId])
}

model FindingReview {
  id            String   @id @default(cuid())
  findingId     String
  finding       Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String
  previousValue Json?
  newValue      Json?
  explanation   String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([findingId, createdAt])
}

model AttackPath {
  id         String     @id @default(cuid())
  scanId     String
  scan       Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title      String
  confidence Confidence
  nodes      Json
  edges      Json
  impact     String     @db.Text
  createdAt  DateTime   @default(now())

  @@index([scanId])
}

model Retest {
  id               String       @id @default(cuid())
  scanId           String
  scan             Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findingId        String?
  finding          Finding?     @relation(fields: [findingId], references: [id], onDelete: SetNull)
  status           RetestStatus @default(QUEUED)
  previousEvidence Json?
  newEvidence      Json?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([scanId, status])
}

model ScannerTool {
  id           String        @id @default(cuid())
  name         String        @unique
  version      String
  kind         String
  enabled      Boolean       @default(true)
  capabilities Json
  rules        ScannerRule[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ScannerRule {
  id            String      @id @default(cuid())
  toolId        String
  tool          ScannerTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  externalId    String
  version       String
  title         String
  severity      Severity
  enabled       Boolean     @default(true)
  configuration Json?

  @@unique([toolId, externalId, version])
}

model Report {
  id        String     @id @default(cuid())
  scanId    String
  scan      Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  type      ReportType
  status    String     @default("READY")
  path      String?
  sha256    String?
  size      Int?
  createdAt DateTime   @default(now())

  @@unique([scanId, type])
}

model EvidenceArtifact {
  id          String            @id @default(cuid())
  scanId      String
  scan        Scan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name        String
  type        String
  storageKey  String
  sha256      String
  size        Int
  contentType String
  metadata    Json?
  evidence    FindingEvidence[]
  createdAt   DateTime          @default(now())
  expiresAt   DateTime?

  @@index([scanId, type])
}

model UploadedArtifact {
  id          String   @id @default(cuid())
  name        String
  storageKey  String
  sha256      String
  size        Int
  contentType String
  status      String
  createdAt   DateTime @default(now())
}

model ContactEnquiry {
  id                    String               @id @default(cuid())
  fullName              String
  email                 String
  company               String?
  role                  String?
  enquiryType           ContactEnquiryType
  websiteUrl            String?
  estimatedWebsiteCount Int?
  preferredScanDepth    ContactScanDepth?
  message               String               @db.Text
  consentAt             DateTime
  status                ContactEnquiryStatus @default(NEW)
  sourcePage            String
  ipHash                String?
  userAgent             String?              @db.Text
  messageHash           String
  assignedAdminId       String?
  assignedAdmin         User?                @relation("AssignedContactEnquiries", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  adminNotes            String?              @db.Text
  emailDeliveryStatus   ContactEmailStatus   @default(NOT_CONFIGURED)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([enquiryType, createdAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([messageHash, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType, resourceId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model WorkerJob {
  id          String    @id @default(cuid())
  scanId      String
  scan        Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  queueJobId  String    @unique
  workerType  String
  status      String
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scanId, status])
}
